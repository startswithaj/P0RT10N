# p0rt1on manager settings. Copy this file to .env and fill in the values below.
# Nothing else has to be set — every other setting already has a working
# default. The full list lives in the EnvVar enum in
# app/packages/server/src/lib/Env.ts; if a name is not in there, it is not
# configurable.

# --- Required. The manager will not start without these. ---------------------

# A strong random secret. The manager uses it to work out the admin password for
# every MinIO instance, and the token instances use to report activity, so those
# never have to be stored anywhere. Back it up: if you lose it or change it, you
# lose admin access to every instance. Keep it out of git.
P0RT1ON_MASTER_KEY=

# Your Tailscale OAuth client secret. It starts with "tskey-client-". Do not use
# a personal API token: those can do anything on your tailnet and expire after
# 90 days. See README "Setup — Tailscale OAuth client".
P0RT1ON_TAILSCALE_OAUTH_CLIENT_SECRET=

# The tag your OAuth client owns. Tailscale only creates keys for tags the
# client owns, so this has to match. If it is wrong you will not find out until
# a friend's instance is already running, and the error will not say why.
P0RT1ON_TAILSCALE_TAG_OWNER=tag:p0rt1on

# Your tailnet's MagicDNS name, e.g. tailXXXX.ts.net. Friend addresses are built
# from it: a friend called alice ends up at https://p0rt1on-alice.<this>
P0RT1ON_TAILSCALE_TAILNET_DOMAIN=

# The pantry: where every friend's backup data is stored. On docker this is an
# absolute path on the disk you want to lend, e.g. /srv/p0rt1on — the manager
# puts each friend's data in its own subdirectory under it. (On kubernetes it is
# instead the name of the StorageClass to provision portion data from — see
# deploy/k8s/pantry.yaml.) The manager's own database must not live inside it.
P0RT1ON_PANTRY=/srv/p0rt1on

# --- Optional. Shown with the value already in use. ---------------------------

# Set both to require a login on the admin UI. With neither set there is no
# login at all, which is only safe while the admin UI stays on localhost.
# P0RT1ON_ADMIN_USERNAME=
# P0RT1ON_ADMIN_PASSWORD=

# Send a copy of every activity event to your own URL, unchanged. Leave unset to
# turn this off. The second value is sent as the Authorization header exactly as
# written, so treat it as a secret and keep it out of git.
# P0RT1ON_MINIO_FORWARD_URL=
# P0RT1ON_MINIO_FORWARD_AUTHORIZATION=

# How much the manager logs: debug, info, warn or error.
# P0RT1ON_LOG_LEVEL=info

# Port for the admin UI and API. It listens on localhost only.
# P0RT1ON_PORT=8080

# Where the manager keeps its database. No secrets are stored in it.
# P0RT1ON_DB_PATH=./data/p0rt1on.db

# How friend access rules get applied. "auto" means the manager edits your
# tailnet policy itself, which needs the Policy File write permission on the
# OAuth client. "manual" means it prints the rules for you to paste in.
# P0RT1ON_TAILSCALE_ACL_MODE=auto
