# p0rt1on manager DEV image: same as the production Dockerfile, but the
# entrypoint also runs the Vite dev server so the frontend is served (with HMR)
# straight from the container. The production image instead builds the SPA and
# serves the static assets from Deno — see the main Dockerfile.
#
# Used by docker-compose.yml, which mounts the live source over /app so both the
# backend and Vite pick up code changes without a rebuild.
FROM denoland/deno:2.9.4

# Bundle the docker CLI the app shells out to (launch/inspect instance
# containers). TARGETARCH is provided by buildkit (amd64 / arm64) so this builds
# on either. docker has no published checksum, so DOCKER_SHA is self-computed
# from the pinned tgz. `mc` is copied from Chainguard's hardened image below.
ARG TARGETARCH
ARG DOCKER_VERSION=27.5.1
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && case "${TARGETARCH}" in \
       amd64) DOCKER_ARCH=x86_64;  DOCKER_SHA=4f798b3ee1e0140eab5bf30b0edc4e84f4cdb53255a429dc3bbae9524845d640 ;; \
       arm64) DOCKER_ARCH=aarch64; DOCKER_SHA=e6b53725a73763ab3f988c73f8772eaed429754c1a579db5ff11f21990fd1817 ;; \
       *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-${DOCKER_VERSION}.tgz" -o /tmp/docker.tgz \
  && echo "${DOCKER_SHA}  /tmp/docker.tgz" | sha256sum -c - \
  && tar -xz -C /usr/local/bin --strip-components=1 -f /tmp/docker.tgz docker/docker \
  && rm -f /tmp/docker.tgz \
  && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# mc (MinIO admin): Chainguard's hardened minio-client — matches the production
# Dockerfile. Installed as `mc` so the app's argv is unchanged.
COPY --from=cgr.dev/chainguard/minio-client:latest /usr/bin/mc /usr/local/bin/mc

WORKDIR /app
COPY deno.json deno.lock ./
COPY app ./app
COPY drizzle ./drizzle
COPY docker-entrypoint.dev.sh ./docker-entrypoint.dev.sh

# Cache deps + typecheck at build time.
RUN deno cache app/packages/server/src/main.ts

# 8080 = manager admin API, 5173 = Vite dev server (frontend). Publish via the
# compose port mapping.
EXPOSE 8080 5173
# Entrypoint runs both the backend and the Vite dev server (see the script).
CMD ["./docker-entrypoint.dev.sh"]
