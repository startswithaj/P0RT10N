{
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": [],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "paths": {
      "styled-system/*": ["./styled-system/*"],
      "@p0rt1on/shared/*": ["../shared/*"],
      "@p0rt1on/server/*": ["../server/src/trpc/root.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/components/ui/**",
    "styled-system/**"
  ]
}
