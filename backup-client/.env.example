# p0rt1on backup-client config. Copy to `backup.env`, fill in, and pass with:
#   docker run --rm --env-file backup.env -v /my/data:/data:ro p0rt1on-backup-client
#
# Values marked "(bundle)" come from the connection bundle your friend hands you.

# --- Required ----------------------------------------------------------------
# Tailscale auth key (bundle). Single-use; persist /var/lib/tailscale to reuse the
# node on later runs. Not needed if SKIP_TAILSCALE=1.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Your S3 endpoint / bucket / credentials (bundle).
S3_ENDPOINT=https://you.tailnet-xxxx.ts.net
S3_BUCKET=you
S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# YOUR client-side encryption password. You choose this — it is NEVER sent to the
# server. If you lose it, your backups are unrecoverable. Keep it somewhere safe.
KOPIA_PASSWORD=choose-a-strong-passphrase

# Path INSIDE the container to back up. Mount your real directory here, e.g.
#   -v /home/me/photos:/data:ro   ->   BACKUP_PATH=/data
BACKUP_PATH=/data

# --- Optional ----------------------------------------------------------------
# S3_REGION=us-east-1
# RETENTION_DAYS=30                 # Object Lock window used when first creating the repo
# TS_HOSTNAME=my-backup-node        # defaults to the container hostname
# TS_EXTRA_ARGS=                    # extra flags for `tailscale up` (e.g. --advertise-tags=...)
# KOPIA_CACHE_DIRECTORY=/cache      # mount a volume here to speed up repeat runs
# SKIP_TAILSCALE=1                  # local testing only: hit S3_ENDPOINT directly, no tailnet
