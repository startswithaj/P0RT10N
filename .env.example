# p0rt1on manager — copy to .env and fill in. See README "Setup — Tailscale".

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Admin API + metadata DB. The admin API always binds loopback; the audit
# webhook has its own listener (AUDIT_PORT, binds 0.0.0.0) so instance
# containers can POST events without exposing the admin surface.
PORT=8080
AUDIT_PORT=8081
DB_PATH=./data/p0rt1on.db

# --- Master key (REQUIRED — boot fails if unset) ---
# Every instance's MinIO root credential is DERIVED from this key, so it must be
# STABLE and BACKED UP: losing or changing it loses admin access to every
# instance. Generate a strong random value and store it in a secret manager
# (K8s secret / mounted file). Never commit the real value.
P0RT1ON_MASTER_KEY=

# --- Tailscale (OAuth client) ---
# The OAuth client SECRET (tskey-client-...). REQUIRED — the manager refuses
# to start without it. See README "Setup — Tailscale OAuth client".
TAILSCALE_OAUTH_CLIENT_SECRET=
# Owner stamped on each friend tag — must equal your OAuth client's tag.
TAILSCALE_TAG_OWNER=tag:p0rt1on
# MagicDNS base for endpoints: https://<name>.<TAILNET_DOMAIN>
TAILNET_DOMAIN=example.ts.net
# Tag worn by each MinIO instance's tailscaled serve node.
SERVE_NODE_TAG=tag:p0rt1on-serve
# ACL management: "auto" edits the tailnet policy via the API (needs the OAuth
# client's Policy File WRITE scope); "manual" skips it and shows the grant lines
# to paste by hand (use this if you didn't grant Policy File write).
TAILSCALE_ACL_MODE=auto

# --- MinIO / instances ---
# Combined MinIO + tailscaled image (see instance/). Docker network the manager
# and instances share (admin plane).
INSTANCE_IMAGE=p0rt1on-instance:latest
P0RT1ON_NETWORK=p0rt1on-net
S3_REGION=us-east-1
MINIO_PORT_MIN=9100
MINIO_PORT_MAX=9999
SHARED_INSTANCE_NAME=pool

# --- Audit webhook (MinIO instance -> manager) ---
# How an instance CONTAINER reaches the manager (not loopback — that's the
# instance itself). host.docker.internal works on Docker Desktop + via the
# compose's extra_hosts on Linux.
AUDIT_WEBHOOK_URL=http://host.docker.internal:8080/internal/audit
