# secrets / local env
.env
*.local
# local backup-client scratch (holds an instance env-file + test data)
.backup-client-test/

# local dev databases
*.db
*.db-shm
*.db-wal
.p0rt1on-dev.db*
data/

# build / tooling output
coverage/
**/dist/
**/styled-system/
node_modules/
# Vite's esbuild dep cache — regenerated on every dev run.
**/.vite/
# Vite writes these transient esbuild-compiled config files next to vite.config.ts
# while loading it; they contain `var` output that trips the lint.
**/vite.config.ts.timestamp-*.mjs

# os
.DS_Store

# Downloaded CLIs for arg verification (mc, tailscale)
.tools/

# Temp dirs for secret-bearing env files (mc creds, auth keys) written by
# DenoTempFiles at runtime and by the integration tests. Never commit these.
.p0rt1on-tmp/
.p0rt1on-it-tmp/
