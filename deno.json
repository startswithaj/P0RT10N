{
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "P14D",
  "workspace": [
    "./app/packages/shared",
    "./app/packages/server",
    "./app/packages/client"
  ],
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@david/dax": "jsr:@david/dax@^0.49.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.7",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/http": "jsr:@std/http@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/streams": "jsr:@std/streams@^1",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "drizzle-orm": "npm:drizzle-orm@^0.45.1",
    "drizzle-kit": "npm:drizzle-kit@^0.31.1",
    "zod": "npm:zod@^3.24",
    "@trpc/server": "npm:@trpc/server@^11",
    "@db/sqlite": "jsr:@db/sqlite@^0.12",
    "better-sqlite3": "npm:better-sqlite3@^11",
    "@cloudydeno/kubernetes-client": "jsr:@cloudydeno/kubernetes-client@^0.8.1",
    "@cloudydeno/kubernetes-apis": "jsr:@cloudydeno/kubernetes-apis@^0.7.2"
  },
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check app/packages/server/src/main.ts app/packages/server/src/trpc/root.ts e2e/*/*.ts",
    "db:generate": "deno -A npm:drizzle-kit generate --config drizzle.config.ts",
    "seed": "deno run --allow-read --allow-write --allow-env --allow-ffi --unstable-ffi devtools/seed.ts",
    "dev:api": "deno run --watch --env-file=.env --allow-read --allow-write --allow-env --allow-ffi --allow-net --allow-run --unstable-ffi app/packages/server/src/main.ts",
    "dev:web": "deno task --cwd app/packages/client dev",
    "dev:demo": "deno task --cwd app/packages/client dev:demo",
    "build:demo": "deno task --cwd app/packages/client build:demo",
    "preview:demo": "deno task --cwd app/packages/client preview:demo",
    "test": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net --allow-run --unstable-ffi --ignore=**/*.e2e.test.ts,app/packages/client/",
    "test:coverage": "deno test --coverage=coverage --allow-read --allow-write --allow-env --allow-ffi --allow-net --allow-run --unstable-ffi --ignore=**/*.e2e.test.ts,app/packages/client/",
    "test:e2e": "deno task test:e2e:k8s && deno task test:e2e:docker",
    "test:e2e:k8s": "deno run --allow-run --allow-read --allow-write --allow-env e2e/k8s/run.ts",
    "test:e2e:docker": "deno run --allow-run --allow-read --allow-write --allow-env e2e/docker/run.ts",
    "test:client": "deno task --cwd app/packages/client test",
    "test:client:coverage": "deno task --cwd app/packages/client test:coverage",
    "coverage": "deno task test:coverage && deno coverage coverage --exclude=test --exclude=packages/client",
    "coverage:lcov": "deno coverage coverage --lcov --exclude=test --exclude=packages/client --output=coverage/lcov.info",
    "coverage:html": "deno coverage coverage --html",
    "coverage:check": "deno task test:coverage && deno task coverage:lcov && deno run --allow-read --allow-env devtools/coverage-threshold.ts",
    "coverage:check:client": "deno task test:client:coverage && deno run --allow-read --allow-env devtools/client-coverage-threshold.ts",
    "check:client": "deno run -A npm:typescript/bin/tsc --noEmit -p app/packages/client/tsconfig.json",
    "verify": "deno fmt --check && deno lint && deno task check && deno task check:client && deno task coverage:check && deno task coverage:check:client",
    "check:all": "deno fmt && deno task verify"
  },
  "lint": {
    "plugins": [
      "./devtools/lint/park-ui-idioms.ts",
      "./devtools/lint/one-component-per-file.ts",
      "./devtools/lint/one-service-per-file.ts",
      "./devtools/lint/blank-line-around-multiline.ts",
      "./devtools/lint/comment-style.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/expression-complexity.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/function-length.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/no-foreach-mutation.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/no-imperative-loops.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/no-let.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/no-param-mutation.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/no-swallowed-catch.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/no-test-globals.ts",
      "https://raw.githubusercontent.com/startswithaj/deno-lint-plugins/main/src/test-file-length.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-non-null-assertion"
      ]
    },
    "exclude": [
      "**/coverage/",
      "**/dist/",
      "**/node_modules/",
      "**/.vite/",
      "**/styled-system/",
      "devtools/",
      "**/components/ui/",
      "p0rt1on-website/",
      ".park-migration-backup/"
    ]
  },
  "fmt": {
    "exclude": [
      "**/coverage/",
      "**/dist/",
      "**/node_modules/",
      "**/.vite/",
      "**/styled-system/",
      "**/components/ui/",
      "p0rt1on-website/",
      ".park-migration-backup/"
    ]
  }
}
